---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCategories, getPrimaryCategory } from '../../lib/content';

const posts = await getCollection('posts');
const categories = getCategories(posts).map((name) => ({
  name,
  count: posts.filter((post) => getPrimaryCategory(post) === name).length,
}));
---

<BaseLayout title="分类" description="按技术领域浏览 hainoir 的文章。">
  <header class="page-intro page-width">
    <p class="eyebrow">CATEGORIES</p>
    <h1>按分类浏览</h1>
    <p>从技术领域进入，查看同一脉络下的学习记录。</p>
  </header>
  <section class="list-layout page-width" aria-label="文章分类">
    <div class="term-grid">
      {categories.map((category) => (
        <a class="term-link" href={`/categories/${encodeURIComponent(category.name)}/`}>
          <strong>{category.name}</strong>
          <span>{category.count} 篇文章</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
