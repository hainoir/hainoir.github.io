---
import { ArrowLeft } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面未找到" description="你访问的页面不存在。">
  <section class="not-found">
    <div>
      <strong>404</strong>
      <h1>这里没有找到内容</h1>
      <p>链接可能已经失效，也可能只是输入有误。</p>
      <a class="button-link primary" href="/"><ArrowLeft size={17} aria-hidden="true" /> 返回首页</a>
    </div>
  </section>
</BaseLayout>
