---
import { ArrowDown } from '@lucide/astro';
import { getCollection } from 'astro:content';
import PostCard from '../components/PostCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { byNewest } from '../lib/content';

const posts = (await getCollection('posts')).sort(byNewest);
const latestPosts = posts.slice(0, 7);
---

<BaseLayout>
  <section class="home-intro" aria-labelledby="hero-title">
    <p class="eyebrow">FRONTEND · ALGORITHMS · NOTES</p>
    <h1 id="hero-title">把问题想清楚，再写下来。</h1>
    <p class="hero-copy">这里记录前端实践、算法推演和那些值得反复理解的问题。</p>
    <a class="button-link primary" href="#latest">开始阅读 <ArrowDown size={17} aria-hidden="true" /></a>
  </section>

  <section class="content-band page-width" id="latest" aria-labelledby="latest-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">LATEST NOTES</p>
        <h2 id="latest-title">最近文章</h2>
        <p>持续整理正在学习和使用的技术，而不是追赶短暂的热度。</p>
      </div>
      <a href="/archives/">查看全部 {posts.length} 篇</a>
    </div>
    <div class="post-grid">
      {latestPosts.map((post, index) => <PostCard post={post} featured={index === 0} />)}
    </div>
  </section>
</BaseLayout>
