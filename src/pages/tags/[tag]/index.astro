---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { byNewest, formatDate, getPostUrl, getPrimaryCategory, getTags, toIsoDate } from '../../../lib/content';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return getTags(posts).map((tag) => ({ params: { tag }, props: { tag } }));
}

const { tag } = Astro.props;
const posts = (await getCollection('posts'))
  .filter((post) => post.data.tags.includes(tag))
  .sort(byNewest);
---

<BaseLayout title={`#${tag}`} description={`${tag}标签下的技术文章。`}>
  <header class="page-intro page-width">
    <p class="eyebrow">TAG</p>
    <h1>#{tag}</h1>
    <p>共 {posts.length} 篇文章。</p>
  </header>
  <section class="list-layout page-width" aria-label={`${tag}标签文章`}>
    <ol class="archive-list">
      {posts.map((post) => (
        <li class="archive-row">
          <time datetime={toIsoDate(post.data.date)}>{formatDate(post.data.date)}</time>
          <a href={getPostUrl(post)}>{post.data.title}</a>
          <span>{getPrimaryCategory(post)}</span>
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>
